            RowBox[{"\"\<$\>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
          "Automatic"}], "]"}], "&"}], ")"}]}]}], "]"}]}]}]], "Input",
