Cell[BoxData[
 TemplateBox[{
   InterpretationBox[Null, 
    EmbeddedHTML[
    "<svg xmlns='http://www.w3.org/2000/svg'\n    \
xmlns:xlink='http://www.w3.org/1999/xlink'\n    width='360'\n    \
height='221.4009'\n    viewBox='0 0 360 221.4009'\n    overflow='visible'\n   \
 preserveAspectRatio='none'\n    data-mapax='24.8832'\n    \
data-mapbx='69.9840'\n    data-mapay='-14.1475'\n    data-mapby='178.1170'\n  \
  id='wgx-f585f171-d93f-456c-9152-30f304e7fe9a'>\n \
<style>.wgx-tip{pointer-events:none;z-index:99999}.wgx-tip \
rect{fill:#ffffe0;stroke:#999;stroke-width:0;z-index:99999}.wgx-tip \
text{font-family:sans-serif;padding-top:20px;z-index:99999}.wgx-status{font-\
family:sans-serif;fill:#757575}.wgx-mo-h{opacity:0;pointer-events:none}.wgx-\
mo:hover .wgx-mo-d{opacity:0}.wgx-mo:hover \
.wgx-mo-h{opacity:1}[data-wgx-click]{transition:transform 0.15s ease}</style>\
\n <script>var L = class B {\n  static svgNamespace = \
\"http://www.w3.org/2000/svg\";\n  elements = [];\n  ssrElements = [];\n  \
activeTooltip = null;\n  activeTooltipSvg = null;\n  priorStyles = /* \
@__PURE__ */ new WeakMap();\n  priorTransforms = /* @__PURE__ */ new \
